# --- Python / uv ---
.venv/
.env
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- data/ is a REAL dir in the repo; track light metadata/ + eda/ (CSV/parquet),
#     but NEVER track the dataset symlinks (huge audio living in ~/storage).
#     Leading slash anchors to repo root so src/data/ is unaffected. ---
/data/gugak_ensemble_71955
/data/gugak_solo_71470
# demo pool (data/gugak_demo_set → ~/storage/gugak-demo-set): incl. YouTube-sourced audio,
# never ours to commit — the manifest under manifests/demo_sets/ is the tracked record.
/data/gugak_demo_set
# demo-set manifests: parquet is canonical; the CSV twins are eyeball copies, regenerable
manifests/demo_sets/*.csv

# --- figs/: generated plots, ignored wholesale — png archive only, kept on disk ---
figs/

# --- data/eda/: QC tables moved to manifests/ (2026-07-27); anything left here is
#     scratch EDA output, disk-only ---
data/eda/*.csv

# --- experiment outputs ---
wandb/
checkpoints/
outputs/
*.log

# Checkpoint dirs relocated to ~/storage (repo disk was at 97%) and symlinked back in.
# The `checkpoints/` rule above has a trailing slash, so it matches DIRECTORIES only —
# git treats a symlink as a file, so the symlinks would show up untracked without this.
experiments/**/checkpoints

# --- notebooks: source tracked (outputs auto-stripped by nbstripout); ignore
#     generated images so binaries stay out of a public repo ---
notebooks/*.png

# --- experiments/: the ONLY experiment-output dir (a stray `runs/` was folded in
#     2026-07-31). Track the parquet metrics + notes only — figures, rendered audio
#     and CSV twins are all regenerable from the tracked parquet plus the script that
#     emitted them. (Checkpoints are already covered by the `checkpoints/` rule.) ---
experiments/**/*.png
experiments/**/*.csv
experiments/**/*.wav
experiments/**/*.flac
# Exception: primary measurement artifacts with no parquet twin. The rule above
# targets CSV/parquet duplicates; this is telemetry a launcher opted into emitting
# (nvidia-smi sampling) and cannot be regenerated without re-running the experiment.
!experiments/**/gpu_mem.csv

# --- presentation_prep/: scratch for a specific talk (slide figures + the one-off
#     scripts that emit them). Untracked wholesale — everything here is regenerable
#     from the tracked manifests/metrics, and slide-specific styling shouldn't
#     accumulate in the repo. ---
presentation_prep/

# --- demo_songs/: rendered separation demos, one subdir per model arm (regenerable
#     by src/render_audio.py from the arm's checkpoint) ---
/demo_songs/

# --- OS / editor ---
.DS_Store

# --- Claude Code: per-machine settings (permissions, local overrides).
#     .claude/settings.json (shared, checked in) is NOT ignored — only the local twin. ---
.claude/settings.local.json

# NOTE: uv.lock IS committed (reproducible env) — do not ignore it.
# NOTE: manifests/parquet/ IS committed (source of truth, frozen splits) — never ignore.
#       manifests/csv/ = eyeball twins: ignored by default (100k-row tables are not
#       meaningfully diff-able), small diff-able tables whitelisted below.
manifests/csv/*
!manifests/csv/eval_manifest.csv
!manifests/csv/activity_summary.csv

# --- data/activity/: stage-1 envelope blob (146 MB, regenerable by
#     src/data/activity_scan.py); the tracked artifacts are the manifests/ tables ---
/data/activity/

# --- data/mix_smoke/: rendered smoke-test mixes (regenerable by
#     scripts/smoke_mix_dataset.py, for listening only) ---
/data/mix_smoke/

# --- data/coherence_examples/: rendered coherent-vs-incoherent A/B listening pairs
#     (regenerable by scripts/render_coherence_examples.py, for listening only) ---
/data/coherence_examples/

# --- MEMO.md: personal scratch notes, anywhere in the tree. Untracked by design —
#     these are for thinking on, not for the record. Findings that survive graduate
#     into the experiment's report or Notion. ---
MEMO.md
